#!/usr/bin/env bash
# Bloqueia commit com segredo. Ativar uma vez: git config core.hooksPath .githooks
set -euo pipefail
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner .
else
  # Sem gitleaks: checagem simples dos padrões mais comuns.
  # Valor longo atribuído a nome de segredo, chave privada PEM ou token do GitHub.
  if git diff --cached -U0 -- . ':(exclude).githooks' | grep -E '^\+' | grep -Ei \
     -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' \
     -e '(token|secret|password|senha)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_/+=-]{24,}' \
     -e 'gh[pousr]_[A-Za-z0-9]{30,}'; then
    echo "Possível segredo no commit. Instale o gitleaks ou remova a linha." >&2
    exit 1
  fi
fi
for f in $(git diff --cached --name-only); do
  case "$f" in
    *.dev.vars|*.env|*.pem|*.key|*secret*) echo "Arquivo proibido no repositório: $f" >&2; exit 1 ;;
  esac
done
